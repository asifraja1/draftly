# Copy this file to `.env` and fill in your real values. `.env` is gitignored.

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# PostgreSQL (same database as the Java app)
DATABASE_URL=postgresql://your-db-user@localhost:5432/draftly

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic names (must match the Java app)
TOPIC_SAVING_EMAIL=saving_email
TOPIC_DRAFT_EMAIL=draft_email
TOPIC_OUTPUT=output_email

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0

# Style-match similarity threshold (0-100)
SIMILARITY_THRESHOLD=80

# Chroma vector store
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=email_embeddings

# gRPC email-fetcher server (the Java app)
GRPC_EMAIL_HOST=localhost
GRPC_EMAIL_PORT=50051
